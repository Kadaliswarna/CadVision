<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp">

    <!-- Top Brand Header -->
    <LinearLayout
        android:id="@+id/brandLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iQOO"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@color/accent_iqoo"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" CADVision"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/taglineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/brandLayout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Server Connection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/connectionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/taglineText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PC Backend Status"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disconnected"
                    android:textColor="@color/accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://192.168.1.100:8000"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Change PC Server IP"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/connectionCard">

        <!-- Scan Object (CameraX) -->
        <Button
            android:id="@+id/btnScanObject"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/scan_object"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/accent_cyan"
            app:cornerRadius="10dp" />

        <!-- Upload Image -->
        <Button
            android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/upload_image"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            android:layout_marginTop="14dp" />

        <!-- View Previous Scans -->
        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/view_previous_scans"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Supports: Mechanical Plates (120x80mm), Flanges, Holes\nRequires: 50mm ArUco reference marker"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
